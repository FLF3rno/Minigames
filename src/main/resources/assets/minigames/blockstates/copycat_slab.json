{
  "multipart": [
    {
      "when": {
        "type": "bottom"
      },
      "apply": {
        "model": "minigames:block/copycat_slab"
      }
    },
    {
      "when": {
        "type": "top"
      },
      "apply": {
        "model": "minigames:block/copycat_slab_top"
      }
    },
    {
      "when": {
        "type": "double"
      },
      "apply": {
        "model": "minigames:block/copycat_slab_full"
      }
    },
    {
      "when": {
        "type": "north"
      },
      "apply": {
        "model": "minigames:block/copycat_slab_vertical"
      }
    },
    {
      "when": {
        "type": "south"
      },
      "apply": {
        "model": "minigames:block/copycat_slab_vertical",
        "y": 180
      }
    },
    {
      "when": {
        "type": "west"
      },
      "apply": {
        "model": "minigames:block/copycat_slab_vertical",
        "y": 270
      }
    },
    {
      "when": {
        "type": "east"
      },
      "apply": {
        "model": "minigames:block/copycat_slab_vertical",
        "y": 90
      }
    }
  ]
}